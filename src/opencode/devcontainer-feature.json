{
    "name": "opencode",
    "id": "opencode",
    "version": "0.0.22",
    "description": "Installs OpenCode, with autostart capabilities",
    "documentationURL": "https://opencode.ai",
	"options": {
		"autostart": {
			"description": "Starts OpenCode automatically",
			"default": false,
			"type": "boolean"
		}
	},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
	"postStartCommand": {
		"opencode": "nohup bash -c '/opt/opencode-init > /var/log/opencode.log 2>&1 &'"
	},
	"mounts": [
		{
			"source": "${localEnv:XDG_DATA_HOME}/opencode",
			"target": "/home/${remoteUser}/.local/share/opencode",
			"type": "volume"
		}
	]
}