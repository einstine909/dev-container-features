{
    "name": "opencode",
    "id": "opencode",
    "version": "0.0.17",
    "description": "Installs OpenCode, with autostart capabilities",
    "documentationURL": "https://opencode.ai",
	"options": {
		"autostart": {
			"description": "Starts OpenCode automatically",
			"default": false,
			"type": "boolean"
		}
	},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
	"postStartCommand": {
		"opencode": "/opt/opencode-init"
	},
	"mounts": [
		{
			"source": "${localEnv:XDG_CONFIG_HOME}/opencode",
			"target": "/home/vscode/.config/opencode",
			"type": "bind"
		}
	]
}